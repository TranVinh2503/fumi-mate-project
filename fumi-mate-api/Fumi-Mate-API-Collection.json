{
	"info": {
		"_postman_id": "fumi-mate-api-v1.0",
		"name": "Fumi Mate API - Japanese Writing Tasks",
		"description": "API for generating Japanese writing tasks with Gemini AI. \n\n## Features\n- Generate Japanese writing prompts\n- 5 task types: letter, speech, opinion, narrative, comparison\n- Level support: N5, N4, N3, N2, N1\n- Complete rubric with 4 criteria (100 points)\n\n## Rate Limiting\n- 1 request per 30 seconds (free tier)\n- Results are cached for reuse\n- Mock data available on rate limit",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
