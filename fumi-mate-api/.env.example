# Database Configuration
# Use port 5432 or 5433 depending on your PostgreSQL setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fumi_mate

# JWT Configuration (CHANGE THIS IN PRODUCTION!)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
DEBUG_AUTH_LOGS=false

# Optional: Gemini AI API Key for AI-powered feedback
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=20
GEMINI_GRADING_MAX_OUTPUT_TOKENS=4096

# Optional: OpenAI/ChatGPT grading
AI_GRADING_PROVIDERS=gemini,openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
