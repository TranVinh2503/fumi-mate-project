{
  "info": {
    "name": "Fumi-Mate API - Japanese Writing Tasks",
    "description": "API for generating Japanese writing tasks with rubric based on debai&tieuchi.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Generate Letter Writing Task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"topic\": \"letter\",\n  \"level\": \"intermediate\",\n  \"numQuestions\": 2\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/tasks/generate",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "5000",
          "path": [
            "api",
            "tasks",
            "generate"
          ]
        }
      },
      "response": []
    },
